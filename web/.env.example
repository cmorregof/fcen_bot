# URL pública de cada backend (Railway). Deje vacío el que no esté desplegado.
NEXT_PUBLIC_API_ACTAS=http://localhost:8001
NEXT_PUBLIC_API_CALIDAD=http://localhost:8002
NEXT_PUBLIC_API_ADMISION=http://localhost:8003
# Client ID del cliente OAuth de Google (el mismo que WEB_GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Solo en local: muestra la entrada con correo ficticio (sin Google).
NEXT_PUBLIC_INGRESO_DEV=true

# Solo en el despliegue de PRÁCTICA (proyecto aparte en Vercel): con
# NEXT_PUBLIC_PRACTICA=true la web usa únicamente estas URLs, nunca las de
# producción, y muestra el banner «ENTORNO DE PRÁCTICA · datos ficticios».
# NEXT_PUBLIC_PRACTICA=true
# NEXT_PUBLIC_API_ACTAS_PRACTICA=
# NEXT_PUBLIC_API_CALIDAD_PRACTICA=
# NEXT_PUBLIC_API_ADMISION_PRACTICA=
