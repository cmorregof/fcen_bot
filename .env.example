# Servicio activo del bot: actas (por defecto), admision o calidad
BOT_SERVICIO=actas

# Telegram (el token NUNCA va al repositorio; en Railway, como variable)
TELEGRAM_BOT_TOKEN=
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
# Código para registrarse: cada administrativa escribe /start <código>
INVITE_CODE=
MAX_USERS=4

# Claude (créditos de la Console)
ANTHROPIC_API_KEY=
# Solo si la key no se creó dentro de un workspace de la Console (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
EXTRACTION_MODEL=claude-sonnet-5-5
CORRECTION_MODEL=claude-sonnet-5-5

# Periodo académico: primer día de clases, para calcular la semana de cada solicitud
PERIODO_ACTUAL=2026-2S
PERIODO_INICIO=
# Mínimo de jurados de Trabajo de Grado. Vacío: se usa config/solicitudes.yaml.
# Si se define, gana al archivo.
JURADOS_MINIMO=

# Cron diario (el mismo valor va en los secrets de GitHub Actions)
INTERNAL_CRON_SECRET=

# Almacenamiento: por defecto <DATA_DIR>/<servicio>/{fcen.db,media,out}.
# El Dockerfile pone DATA_DIR=/data (el volumen de Railway). Solo define
# DB_PATH, MEDIA_DIR u OUTPUT_DIR si necesitas otra ruta.
DATA_DIR=data

# Servicio de admisión (BOT_SERVICIO=admision). Ver docs/admision/despliegue.md
# ADMISION_INSUMOS_DIR=~/fcen_insumos/admision
# ADMISION_CONTACTO=
# ADMISION_ADMIN_IDS=
# ADMISION_LIMITE_PREGUNTAR_HORA=20
# ADMISION_LIMITE_REVISAR_HORA=10
# ADMISION_LIMITE_CONSENTIMIENTO_HORA=30

# Decanatura (Decana y vicedecanos): ids numéricos de Telegram, separados por comas.
# Solo ellos pueden usar /resumen y reciben el resumen semanal (lunes 7:30 a. m.).
DECANATURA_TELEGRAM_IDS=
# false apaga el envío semanal; /resumen sigue funcionando.
RESUMEN_SEMANAL_ACTIVO=true
RESUMEN_DIAS_SIN_MOVIMIENTO=7
# Secreto compartido por actas, calidad y admisión para /internal/cifras.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
RESUMEN_SECRET=
# Solo en actas: URL pública de calidad y de admisión (vacías = sin esa línea).
RESUMEN_CALIDAD_URL=
RESUMEN_ADMISION_URL=

# Calidad: revisión de soportes desde la web (docs/calidad/cierre.md).
# Apagada hasta tener el aval de tratamiento de datos.
CALIDAD_REVISOR_ACTIVO=false
CALIDAD_REVISOR_TOPE_USD=10
CALIDAD_REVISOR_RETENCION_DIAS=30
