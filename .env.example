# Telegram (el token NUNCA va al repositorio; en Railway, como variable)
TELEGRAM_BOT_TOKEN=
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
# Código para registrarse: cada administrativa escribe /start <código>
INVITE_CODE=
MAX_USERS=4

# Claude (créditos de la Console)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5
CORRECTION_MODEL=claude-sonnet-5-5

# Periodo académico: primer día de clases, para calcular la semana de cada solicitud
PERIODO_ACTUAL=2026-2S
PERIODO_INICIO=

# Cron diario (el mismo valor va en los secrets de GitHub Actions)
INTERNAL_CRON_SECRET=

# En Railway, con un volumen montado en /data
DB_PATH=data/fcen.db
MEDIA_DIR=data/media
OUTPUT_DIR=data/out
